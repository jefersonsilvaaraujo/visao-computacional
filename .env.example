# Copie este arquivo para ".env" para alterar as configurações (opcional).

# Porta da interface no navegador: http://localhost:8080
PORTA=8080

# PIN do painel do monitor / responsável técnico (troque antes do evento!)
MONITOR_PIN=2026

# Modelo de linguagem do Ollama (textual, pequeno e quantizado)
LLM_MODELO=llama3.2:3b

# Pesos do detector YOLO usados no build (yolo11n = mais rápido; yolo11s = mais preciso)
# Se alterar, refaça o build: docker compose build
MODELO_YOLO=yolo11n

# Número de threads de CPU do detector (0 = automático)
THREADS_DETECTOR=0

# Núcleos de CPU da LLM quando ela roda sem GPU (0 = automático: os que o detector deixa livres)
LLM_THREADS=0

# Versão da imagem do Ollama
OLLAMA_VERSAO=0.6.8

# Fuso horário dos logs técnicos
FUSO_HORARIO=America/Sao_Paulo
